{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Xamppify",
  "version": "0.4.0",
  "identifier": "com.alvin.xamppify",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Xamppify",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "publisher": "Alvin",
    "copyright": "MIT",
    "category": "DeveloperTool",
    "shortDescription": "Your local PHP workspace, simplified",
    "longDescription": "A desktop workspace for managing local XAMPP projects, files, databases, logs, configuration, and SSL certificates."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJDOEMyQzc3REU2OTMwODUKUldTRk1HbmVkeXlNdkxnZUNhMW1aUC9MTFBER2k1YmMyYWVOeUkzQmF3cUxVZVg1TmNoWHp5UUgK",
      "endpoints": [
        "https://raw.githubusercontent.com/alvindemesadev/xamppify/main/latest.json"
      ]
    }
  }
}
